# 로컬 MySQL 컨테이너
MYSQL_DATABASE=school_communication
MYSQL_USER=school_app
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306

# Spring Boot 데이터소스
DB_URL='jdbc:mysql://localhost:3306/school_communication?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC'
DB_USERNAME=school_app
DB_PASSWORD=replace-with-local-app-password
DB_POOL_MAX_SIZE=12
DB_POOL_MIN_IDLE=2
BACKEND_PORT=8080

# 세션과 개발 문서
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# 조정 가능한 초기 속도 제한 설정
LOGIN_FAILURES_BEFORE_DELAY=5
LOGIN_MAXIMUM_DELAY_SECONDS=300
GENERAL_REQUESTS_PER_MINUTE=120
ACTIVATION_CODE_TTL=24h
PASSWORD_RESET_CODE_TTL=30m
REAUTHENTICATION_TTL=10m
MINIMUM_PASSWORD_LENGTH=12
MAXIMUM_PASSWORD_LENGTH=128
# 예시 값을 그대로 운영에 사용하지 말고 비밀 저장소에서 32자 이상의 무작위 값을 공급한다.
THROTTLE_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
# 32바이트 무작위 키를 Base64로 인코딩해 비밀 저장소에서 공급한다.
PROPOSAL_IDENTITY_KEY_BASE64=replace-with-base64-encoded-32-byte-random-key
PROPOSAL_IDENTITY_KEY_VERSION=1
PROPOSAL_SUPPORT_THRESHOLD=50

# Next.js가 브라우저의 /api 요청을 전달할 내부 백엔드 주소
BACKEND_INTERNAL_URL=http://localhost:8080
