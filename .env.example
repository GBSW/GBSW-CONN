# ──────────────────────────────────────────────────────────────────────────────
# 학교 소통 제안 시스템 — 환경변수 예시
#
# 이 파일을 복사해 .env 를 만들고 실제 값을 채워라.
# .env 는 절대 저장소에 커밋하지 않는다. (.gitignore에 포함됨)
# ──────────────────────────────────────────────────────────────────────────────

# ── 데이터베이스 ──────────────────────────────────────────────────────────────
# 로컬 개발은 docker-compose.yml 의 MySQL 컨테이너를 사용한다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gbsw_proposal
DB_USERNAME=
DB_PASSWORD=
# 운영 환경에서는 DB_ROOT_PASSWORD 를 반드시 강한 무작위 값으로 설정한다.
DB_ROOT_PASSWORD=

# ── 세션 ──────────────────────────────────────────────────────────────────────
# 서버 세션 비밀값 — 예측 불가능한 긴 무작위 문자열로 설정한다.
# 이 값이 노출되면 세션 위조가 가능하므로 즉시 교체하고 모든 세션을 무효화한다.
SESSION_SECRET=

# ── 암호화 키 (익명 작성자 신원 보호) ────────────────────────────────────────
# Base64 인코딩된 256비트 무작위 키.
# 교체 시 기존 암호화 데이터 복호화가 불가능해지므로 키 버전 관리 절차를 따른다.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_KEY_VERSION=1

# ── HMAC 서명 키 ──────────────────────────────────────────────────────────────
HMAC_KEY=

# ── 외부 API ──────────────────────────────────────────────────────────────────
# 학교알리미(NEIS) Open API 키 — 재정·공시 정보 연동에 사용한다.
# 아직 발급받지 않았으면 빈 값으로 두면 외부 연동 기능이 비활성화된다.
NEIS_API_KEY=
NEIS_API_BASE_URL=https://open.neis.go.kr

# ── 백엔드 서버 ───────────────────────────────────────────────────────────────
BACKEND_PORT=8080
# 로컬 개발 기준. 운영 환경에서는 실제 도메인과 HTTPS URL 로 변경한다.
BACKEND_BASE_URL=http://localhost:8080

# ── 프런트엔드 ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ 접두사 변수는 브라우저에 노출된다. 비밀값을 여기에 넣지 마라.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PORT=3000
