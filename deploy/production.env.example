# Every image must be replaced with a registry reference containing @sha256:<verified digest>.
MYSQL_IMAGE=mysql:8.4.10@sha256:REPLACE_WITH_VERIFIED_DIGEST
BACKEND_IMAGE=registry.example.invalid/gbsw/backend@sha256:REPLACE_WITH_VERIFIED_DIGEST
FRONTEND_IMAGE=registry.example.invalid/gbsw/frontend@sha256:REPLACE_WITH_VERIFIED_DIGEST
NGINX_IMAGE=nginxinc/nginx-unprivileged:alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

DB_NAME=REPLACE_WITH_APPROVED_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_APPLICATION_DATABASE_USER
DB_URL=REPLACE_WITH_INTERNAL_JDBC_URL_AND_APPROVED_TLS_OPTIONS
PROPOSAL_IDENTITY_KEY_VERSION=REPLACE_WITH_POSITIVE_KEY_VERSION
PROPOSAL_OWNERSHIP_KEY_VERSION=REPLACE_WITH_POSITIVE_KEY_VERSION
CREDENTIAL_DELIVERY_ENDPOINT=https://REPLACE_WITH_RECIPIENT_BOUND_DELIVERY_SERVICE
TRUSTED_PROXY_CIDRS=REPLACE_WITH_TLS_PROXY_CIDR

# These paths must point to files supplied outside the repository by the chosen secret manager.
DB_PASSWORD_FILE=/run/operator-secrets/db_password
DB_ROOT_PASSWORD_FILE=/run/operator-secrets/db_root_password
THROTTLE_FINGERPRINT_SECRET_FILE=/run/operator-secrets/throttle_fingerprint_secret
PROPOSAL_IDENTITY_KEY_BASE64_FILE=/run/operator-secrets/proposal_identity_key_base64
PROPOSAL_OWNERSHIP_KEY_BASE64_FILE=/run/operator-secrets/proposal_ownership_key_base64
CREDENTIAL_DELIVERY_BEARER_TOKEN_FILE=/run/operator-secrets/credential_delivery_bearer_token

# Bind to loopback until an approved TLS ingress forwards traffic to this port.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=8080
